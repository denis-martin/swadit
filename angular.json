{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sb-admin-angular4-bootstrap4": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": [
              "zone.js",
              "src/polyfills.ts"
            ],
            "assets": [
              "src/assets",
              "src/favicon.ico"
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/v4-shims.min.css",
              "node_modules/prismjs/themes/prism-coy.css",
              "node_modules/swagger-ui-dist/swagger-ui.css",
              "src/styles/app.scss"
            ],
            "scripts": [
              "node_modules/prismjs/prism.js",
              "node_modules/prismjs/components/prism-json.min.js",
              "node_modules/ace-builds/src-min/ace.js",
              "node_modules/ace-builds/src-min/theme-eclipse.js",
              "node_modules/ace-builds/src-min/mode-yaml.js",
              "node_modules/ace-builds/src-min/ext-searchbox.js",
              "node_modules/swagger-ui-dist/swagger-ui-bundle.js",
              "node_modules/swagger-ui-dist/swagger-ui-standalone-preset.js"
            ],
            "allowedCommonJsDependencies": [
              "@apidevtools/swagger-parser",
              "file-saver"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts",
            "externalDependencies": [
              "marked-katex-extension"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/./environments/environment.ts",
                  "with": "src/./environments/environment.prod.ts"
                }
              ]
            },
            "testing": {
              "aot": false,
              "styles": [
                "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
                "node_modules/@fortawesome/fontawesome-free/css/v4-shims.min.css",
                "node_modules/prismjs/themes/prism-coy.css",
                "node_modules/swagger-ui-dist/swagger-ui.css",
                "src/styles/app.scss"
              ],
              "scripts": [
                "node_modules/prismjs/prism.js",
                "node_modules/prismjs/components/prism-json.min.js",
                "node_modules/prismjs/components/prism-yaml.min.js",
                "node_modules/ace-builds/src-min/ace.js",
                "node_modules/ace-builds/src-min/theme-eclipse.js",
                "node_modules/ace-builds/src-min/mode-yaml.js",
                "node_modules/ace-builds/src-min/ext-searchbox.js",
                "node_modules/swagger-ui-dist/swagger-ui-bundle.js",
                "node_modules/swagger-ui-dist/swagger-ui-standalone-preset.js"
              ],
              "polyfills": [
                "zone.js",
                "zone.js/testing",
                "src/polyfills.ts"
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "sb-admin-angular4-bootstrap4:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "sb-admin-angular4-bootstrap4:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "sb-admin-angular4-bootstrap4:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "src/tsconfig.spec.json",
            "reporters": [
              "default"
            ],
            "coverageReporters": [
              "html",
              "text-summary"
            ],
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        }
      }
    }
  },
  "cli": {
    "warnings": {}
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "app",
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
