{
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "module": "es2020",
    "esModuleInterop": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "paths": {
      "app/*": [
        "./src/app/*"
      ]
    },
    "resolveJsonModule": true,
    "useDefineForClassFields": false,
    "strict": false
  }
}
