{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "module": "preserve",
    "paths": {
      "app/*": [
        "./app/*"
      ],
      "testing/*": [
        "./testing/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "files": [
    "polyfills.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
