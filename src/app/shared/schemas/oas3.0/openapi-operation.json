{
	"title": "Editor schema for OpenAPI 3.0 operations (parameters, request body, responses and security are edited separately).",
	"id": "https://spec.openapis.org/oas/3.0/schema/2020-02-25#/definitions/Operation",
	"$schema": "http://json-schema.org/draft-04/schema#",
	"type": "object",
	"required": [ "responses" ],
	"x-swadit-editor-groups": [
		{
			"x-swadit-editor-grid": [
				[ "summary", "deprecated" ],
				[ "description" ]
			],
			"x-swadit-editor-grid-cols": {
				"summary": 10,
				"deprecated": 2,
				"description": 12
			}
		},
		{
			"x-swadit-editor-grid": [
				[ "operationId" ],
				[ "tags" ]
			],
			"x-swadit-editor-grid-cols": {
				"operationId": 12,
				"tags": 12
			}
		},
		{
			"x-swadit-editor-grid": [
				[ "externalDocs" ]
			],
			"x-swadit-editor-grid-cols": {
				"externalDocs": 12
			}
		}
	],
	"properties": {
		"summary": {
			"type": "string",
			"description": "A short summary of what the operation does."
		},
		"deprecated": {
			"type": "boolean",
			"default": false
		},
		"description": {
			"type": "string",
			"description": "A verbose explanation of the operation behavior. CommonMark syntax MAY be used for rich text representation.",
			"x-swadit-input-multiline": 10,
			"x-swadit-input-class": "monospace"
		},
		"externalDocs": {
			"x-swadit-editor-card": true,
			"type": "object",
			"description": "Additional external documentation for this operation",
			"required": [ "url" ],
			"properties": {
				"url": {
					"type": "string",
					"format": "uri-reference"
				},
				"description": {
					"type": "string"
				}
			}
		},
		"tags": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"uniqueItems": true
		},
		"operationId": {
			"type": "string",
			"description": "Unique string used to identify the operation."
		}
	}
}
